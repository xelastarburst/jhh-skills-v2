<?xml version="1.0" encoding="UTF-8"?>
<!--
  Virtual Jensen — daily ingest tick (launchd).

  Runs the ingest pipeline at 06:00 local every day. Fetches the
  `daily` tier (fast-moving news, earnings, new videos/podcasts),
  invokes the wiki/interview subagents in DRY-RUN mode, and leaves
  state.json alone — so this plist is safe to enable even on a
  fresh machine.

  To flip to --apply (actually land branches + append to the log),
  copy this file, change ProgramArguments to include "--apply", and
  give the copy a different `Label`.

  Install:
      cp scripts/launchd/com.virtual-jensen.daily.plist \
         ~/Library/LaunchAgents/
      launchctl load -w ~/Library/LaunchAgents/com.virtual-jensen.daily.plist

  Uninstall:
      launchctl unload -w ~/Library/LaunchAgents/com.virtual-jensen.daily.plist
      rm ~/Library/LaunchAgents/com.virtual-jensen.daily.plist

  IMPORTANT: before installing, edit the WorkingDirectory and
  ProgramArguments paths below to match YOUR clone location (the
  default is /Users/alex/Documents/jhh-skills-v2).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.virtual-jensen.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/alex/Documents/jhh-skills-v2/virtual-jensen-web/.venv/bin/python</string>
        <string>/Users/alex/Documents/jhh-skills-v2/scripts/ingest/run.py</string>
        <string>--tier</string><string>daily</string>
        <string>--invoke-agents</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/alex/Documents/jhh-skills-v2</string>

    <key>StandardOutPath</key>
    <string>/Users/alex/Documents/jhh-skills-v2/scripts/ingest/logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/alex/Documents/jhh-skills-v2/scripts/ingest/logs/daily.err.log</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- Run if the machine was asleep at 06:00 — catch-up on next wake. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Keep crashed jobs from respawning in a loop. -->
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <!-- Disabled on install; flip with `launchctl load -w`. -->
    <key>Disabled</key>
    <true/>
</dict>
</plist>
