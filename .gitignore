__pycache__/
*.pyc
.DS_Store
.venv/
.env

# ingestion pipeline state — dedupe cache, history lives in commits
scripts/ingest/state.json
scripts/ingest/state.json.tmp

# fetched transcripts — downloaded on demand, not source of truth
scripts/ingest/transcripts/

# benchmark run records — kept local by default (full transcripts can be bulky).
# If you want to track trends in git, `git add -f scripts/bench/history/*.json`
# on the runs you care about.
scripts/bench/history/*.json
